# Server
PORT=5000

# Reverse proxy / rate limiting
# Number of trusted reverse-proxy hops in front of this app (e.g. Railway sets 1).
# MUST stay 0 when this app is reachable directly by clients, otherwise anyone
# could spoof X-Forwarded-For and bypass IP-based rate limits.
TRUST_PROXY_HOPS=0

# MongoDB
# Format: mongodb://user:pass@host:port/dbname or mongodb+srv://...
MONGODB_URI=

# JWT
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=
# Token lifetime string accepted by jsonwebtoken, e.g. 15m, 1h, 7d
JWT_EXPIRES_IN=7d

# Email verification (Brevo)
# Required in production. API v3 key from https://app.brevo.com/settings/keys/api (starts with xkeysib-)
BREVO_API_KEY=
# Verified sender on Brevo (a verified sender/domain registered in your Brevo account)
# Required in production.
EMAIL_FROM=
# Public base URL of the frontend used to build email verification links
FRONTEND_URL=http://localhost:5173

# Legacy provider (Resend) — retained during the migration, NOT used while Brevo is active.
# RESEND_API_KEY=